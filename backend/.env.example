# Server Configuration
PORT=5000
NODE_ENV=development

# Real MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/parkease
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/parkease?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/parkease

# JWT Authentication Secret & Expiration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Razorpay test or live keys. Online payments stay disabled until both are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
